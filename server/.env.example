# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stock_tracker

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# External Stock Price API (Finnhub)
# Get a free key at https://finnhub.io/ — leave as your_api_key_here to use demo prices
STOCK_API_KEY=your_api_key_here
STOCK_API_BASE_URL=https://finnhub.io/api/v1

# Price broadcast interval (ms)
PRICE_POLL_INTERVAL_MS=15000
